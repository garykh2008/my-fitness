# 正式環境變數範本 —— 在 VPS 上複製成 .env.production 並填入實際值。
#   cp .env.production.example .env.production && nano .env.production
#
# 這些全部只在伺服器端使用，不會進瀏覽器，也不是建置期變數 ——
# 改完只要 `docker compose up -d`（不需要 --build）就會生效。

# === 網站本身（瀏覽器走 Supabase Auth cookie session + RLS）===
# anon key 在 /root/supabase-mangan-log/docker/.env 裡，變數名 ANON_KEY。
SUPABASE_URL=https://supabase.garyhsieh-proj.com
SUPABASE_ANON_KEY=
SUPABASE_DB_SCHEMA=fitness

# === AI 教練 API（/api/coach/*）===
# 不設 COACH_API_TOKEN 的話，整組教練端點一律回 503（fail closed）。
#
# 產生一組夠長的隨機 token：
#   openssl rand -hex 32
COACH_API_TOKEN=

# 教練建立的訓練卡要掛在誰名下
COACH_OWNER_EMAIL=garykh2008@gmail.com

# service_role 金鑰（同一個檔案裡的 SERVICE_ROLE_KEY）。
# 教練是機器呼叫、沒有使用者 JWT，RLS 無從判斷擁有者，只能用 service_role 寫入。
# 這把金鑰會繞過 RLS，只放伺服器、切勿外流；只有通過 COACH_API_TOKEN 驗證的
# 請求才走得到它。
SUPABASE_SERVICE_ROLE_KEY=

# 回傳訓練卡連結時用的網址前綴（選填，沒設就回相對路徑）
APP_BASE_URL=https://fitness.garyhsieh-proj.com

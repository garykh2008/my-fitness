# 正式環境變數範本 —— 在 VPS 上複製成 .env.production 並填入實際值。
#   cp .env.production.example .env.production && nano .env.production
#
# anon key 在 /root/supabase-mangan-log/docker/.env 裡，變數名 ANON_KEY。
#
# 這些全部只在伺服器端使用，不會進瀏覽器，也不是建置期變數 ——
# 改完只要 `docker compose up -d`（不需要 --build）就會生效。

SUPABASE_URL=https://supabase.garyhsieh-proj.com
SUPABASE_ANON_KEY=
SUPABASE_DB_SCHEMA=fitness
